# AVance HelpDesk · environment template
# Copia este ficheiro para .env.local e preenche.
# As variáveis prefixadas com VITE_ ficam expostas ao bundle do frontend
# — nunca coloques aqui chaves de serviço (service_role).

# Supabase (em Project Settings → API Keys)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Password partilhada das contas demo (funcionario@helpdesk.demo, ti@helpdesk.demo)
# Cria as contas em Supabase Studio → Authentication → Users → Add user
VITE_DEMO_PASSWORD=
